# Malaysia Open Data MCP Server - Environment Variables

# Google Maps API Key (Optional)
# If provided, the GTFS transit tools will use Google Maps API for geocoding
# If not provided, the system will automatically use Nominatim (OpenStreetMap) API
GRABMAPS_API_KEY=your_grabmaps_api_key_here
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=ap-southeast-5

GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional GitHub PAT for higher API rate limits (recommended in production)
GH_PAT=your_github_pat_here

# Analytics
ANALYTICS_RESET_KEY=your_analytics_reset_key_here
ANALYTICS_DIR=/app/data

# Firebase
FIREBASE_DATABASE_URL=your_firebase_database_url_here
FIREBASE_CREDENTIALS_PATH=.credentials/firebase-service-account.json
